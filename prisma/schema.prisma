generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PlanType {
  COMMERCIAL
  MEDICARE
  MEDICAID
  SELF_PAY
}

enum Sex {
  M
  F
  U
}

enum SexSpecific {
  M
  F
  ANY
}

enum PolicyRank {
  PRIMARY
  SECONDARY
}

enum EncounterStatus {
  OPEN
  CODED
  BILLED
}

enum ClaimStatus {
  DRAFT
  READY
  SUBMITTED
  ACCEPTED
  REJECTED
  PAID
  PARTIALLY_PAID
  DENIED
  APPEALED
  CLOSED
}

enum ClaimLineStatus {
  OPEN
  PAID
  DENIED
  ADJUSTED
}

enum EditSeverity {
  ERROR
  WARNING
}

enum DenialCategory {
  ELIGIBILITY
  CODING
  AUTHORIZATION
  TIMELY_FILING
  DUPLICATE
  MEDICAL_NECESSITY
  OTHER
}

enum DenialStatus {
  OPEN
  IN_PROGRESS
  APPEALED
  WRITTEN_OFF
  RESOLVED
}

model Payer {
  id            String            @id @default(cuid())
  name          String
  payerId       String            @unique
  planType      PlanType
  allowedRate   Float
  avgDaysToPay  Int
  policies      InsurancePolicy[]
  claims        Claim[]
  remittances   Remittance[]
  policySources PolicySource[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Patient {
  id          String            @id @default(cuid())
  mrn         String            @unique
  firstName   String
  lastName    String
  dob         DateTime?
  sex         Sex
  phone       String?
  addressLine String?
  city        String?
  state       String?
  zip         String?
  policies    InsurancePolicy[]
  encounters  Encounter[]
  claims      Claim[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model InsurancePolicy {
  id              String     @id @default(cuid())
  patientId       String
  payerId         String
  memberId        String
  groupNumber     String?
  rank            PolicyRank
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  copay           Float
  deductible      Float
  deductibleMet   Float
  coinsuranceRate Float
  patient         Patient    @relation(fields: [patientId], references: [id])
  payer           Payer      @relation(fields: [payerId], references: [id])
  claims          Claim[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([patientId])
  @@index([payerId])
}

model Provider {
  id         String      @id @default(cuid())
  npi        String      @unique
  firstName  String
  lastName   String
  specialty  String
  taxonomy   String?
  encounters Encounter[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model ProcedureCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  description         String
  defaultCharge       Float
  isEvalAndManagement Boolean
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DiagnosisCode {
  id          String               @id @default(cuid())
  code        String               @unique
  description String
  sexSpecific SexSpecific          @default(ANY)
  encounters  EncounterDiagnosis[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Encounter {
  id             String               @id @default(cuid())
  patientId      String
  providerId     String
  dateOfService  DateTime
  placeOfService String?
  status         EncounterStatus
  notes          String?
  patient        Patient              @relation(fields: [patientId], references: [id])
  provider       Provider             @relation(fields: [providerId], references: [id])
  diagnoses      EncounterDiagnosis[]
  chargeLines    ChargeLine[]
  claims         Claim[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([patientId])
  @@index([providerId])
  @@index([dateOfService])
}

model EncounterDiagnosis {
  id            String        @id @default(cuid())
  encounterId   String
  diagnosisCode String
  sequence      Int
  encounter     Encounter     @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  diagnosis     DiagnosisCode @relation(fields: [diagnosisCode], references: [code])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([encounterId])
  @@index([diagnosisCode])
}

model ChargeLine {
  id                String    @id @default(cuid())
  encounterId       String
  cptCode           String
  modifiers         String
  units             Int
  chargeAmount      Float
  diagnosisPointers String
  encounter         Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([encounterId])
}

model Claim {
  id                    String           @id @default(cuid())
  claimNumber           String           @unique
  patientId             String
  encounterId           String
  payerId               String
  policyId              String?
  status                ClaimStatus
  totalCharge           Float
  totalAllowed          Float
  totalPaid             Float
  totalAdjustment       Float
  patientResponsibility Float
  balance               Float
  billedAt              DateTime?
  submittedAt           DateTime?
  lastScrubbedAt        DateTime?
  cleanOnFirstPass      Boolean?
  patient               Patient          @relation(fields: [patientId], references: [id])
  encounter             Encounter        @relation(fields: [encounterId], references: [id])
  payer                 Payer            @relation(fields: [payerId], references: [id])
  policy                InsurancePolicy? @relation(fields: [policyId], references: [id])
  lines                 ClaimLine[]
  edits                 ClaimEdit[]
  events                ClaimEvent[]
  remittanceLines       RemittanceLine[]
  denials               Denial[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([patientId])
  @@index([encounterId])
  @@index([payerId])
  @@index([policyId])
  @@index([status])
}

model ClaimLine {
  id                    String           @id @default(cuid())
  claimId               String
  lineNumber            Int
  cptCode               String
  modifiers             String
  units                 Int
  chargeAmount          Float
  allowedAmount         Float
  paidAmount            Float
  adjustmentAmount      Float
  patientResponsibility Float
  diagnosisPointers     String
  status                ClaimLineStatus
  claim                 Claim            @relation(fields: [claimId], references: [id], onDelete: Cascade)
  remittanceLines       RemittanceLine[]
  denials               Denial[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([claimId])
}

model ClaimEdit {
  id        String       @id @default(cuid())
  claimId   String
  severity  EditSeverity
  code      String
  field     String?
  message   String
  claim     Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([claimId])
}

model ClaimEvent {
  id          String   @id @default(cuid())
  claimId     String
  type        String
  description String
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([claimId])
}

model Remittance {
  id          String           @id @default(cuid())
  checkNumber String           @unique
  payerId     String
  paymentDate DateTime
  totalPaid   Float
  postedAt    DateTime?
  payer       Payer            @relation(fields: [payerId], references: [id])
  lines       RemittanceLine[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([payerId])
  @@index([paymentDate])
}

model RemittanceLine {
  id                    String     @id @default(cuid())
  remittanceId          String
  claimId               String
  claimLineId           String
  allowedAmount         Float
  paidAmount            Float
  adjustmentAmount      Float
  patientResponsibility Float
  carc                  String?
  rarc                  String?
  remittance            Remittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  claim                 Claim      @relation(fields: [claimId], references: [id])
  claimLine             ClaimLine  @relation(fields: [claimLineId], references: [id])
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([remittanceId])
  @@index([claimId])
  @@index([claimLineId])
}

model Denial {
  id          String         @id @default(cuid())
  claimId     String
  claimLineId String?
  carc        String
  rarc        String?
  reason      String
  category    DenialCategory
  status      DenialStatus
  assignedTo  String?
  notes       String?
  claim       Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimLine   ClaimLine?     @relation(fields: [claimLineId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([claimId])
  @@index([claimLineId])
  @@index([category])
  @@index([status])
}

enum PolicyChangeStatus {
  NEW
  REVIEWED
  ACTIONED
  DISMISSED
}

enum ChangeSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AuditFindingType {
  CODE_REMOVED
  CODE_ADDED
  PRIOR_AUTH
  NOT_COVERED
  MODIFIER_RULE
  FREQUENCY_LIMIT
  POLICY_MENTION
}

enum AuditFindingStatus {
  OPEN
  RESOLVED
  IGNORED
}

model PolicySource {
  id            String           @id @default(cuid())
  payerId       String
  name          String
  url           String
  description   String?
  enabled       Boolean          @default(true)
  lastCheckedAt DateTime?
  lastChangedAt DateTime?
  lastError     String?
  payer         Payer            @relation(fields: [payerId], references: [id])
  snapshots     PolicySnapshot[]
  changes       PolicyChange[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([payerId])
}

model PolicySnapshot {
  id          String         @id @default(cuid())
  sourceId    String
  fetchedAt   DateTime       @default(now())
  contentHash String
  title       String?
  content     String
  byteLength  Int
  source      PolicySource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  changesFrom PolicyChange[] @relation("ChangeFrom")
  changesTo   PolicyChange[] @relation("ChangeTo")

  @@index([sourceId, fetchedAt])
}

model PolicyChange {
  id             String             @id @default(cuid())
  sourceId       String
  fromSnapshotId String?
  toSnapshotId   String
  detectedAt     DateTime           @default(now())
  severity       ChangeSeverity
  status         PolicyChangeStatus @default(NEW)
  title          String
  addedLines     String
  removedLines   String
  affectedCodes  String
  signals        String             @default("[]")
  aiSummary      String?
  aiModel        String?
  notes          String?
  source         PolicySource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  fromSnapshot   PolicySnapshot?    @relation("ChangeFrom", fields: [fromSnapshotId], references: [id])
  toSnapshot     PolicySnapshot     @relation("ChangeTo", fields: [toSnapshotId], references: [id])
  findings       AuditFinding[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([sourceId])
  @@index([detectedAt])
  @@index([status])
}

model DailyDigest {
  id          String   @id @default(cuid())
  digestDate  DateTime @unique
  changeCount Int
  sourceCount Int
  headline    String
  body        String
  aiModel     String?
  createdAt   DateTime @default(now())
}

model Chargemaster {
  id         String             @id @default(cuid())
  name       String
  fileName   String?
  itemCount  Int
  uploadedAt DateTime           @default(now())
  auditedAt  DateTime?
  items      ChargemasterItem[]
  findings   AuditFinding[]
}

model ChargemasterItem {
  id             String       @id @default(cuid())
  chargemasterId String
  cptCode        String
  description    String
  price          Float
  modifiers      String?
  revenueCode    String?
  department     String?
  chargemaster   Chargemaster @relation(fields: [chargemasterId], references: [id], onDelete: Cascade)

  @@index([chargemasterId])
  @@index([cptCode])
}

model AuditFinding {
  id             String             @id @default(cuid())
  chargemasterId String
  changeId       String?
  cptCode        String
  type           AuditFindingType
  severity       ChangeSeverity
  status         AuditFindingStatus @default(OPEN)
  message        String
  recommendation String
  evidence       String?
  chargemaster   Chargemaster       @relation(fields: [chargemasterId], references: [id], onDelete: Cascade)
  change         PolicyChange?      @relation(fields: [changeId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([chargemasterId])
  @@index([changeId])
  @@index([cptCode])
}
