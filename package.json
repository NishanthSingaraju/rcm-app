{
  "name": "rcm-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"prisma/**/*.{ts,tsx}\"",
    "db:reset": "prisma migrate reset --force && npm run seed",
    "seed": "tsx prisma/seed.ts",
    "policies:seed": "tsx prisma/seed-policies.ts",
    "policies:daily": "tsx scripts/policies-daily.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cheerio": "1.1.2",
    "lucide-react": "0.468.0",
    "next": "15.5.25",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
